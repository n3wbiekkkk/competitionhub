# PostgreSQL 16 (Docker Compose / Self-Hosted)
POSTGRES_DB=tech_competition_hub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
APP_DB_USER=techhub_app
APP_DB_PASSWORD=change-me-app-password
DATABASE_URL=postgresql://techhub_app:change-me-app-password@localhost:5432/tech_competition_hub

# Local Auth Session Secret (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-at-least-32-chars-random-secret

# OpenTyphoon AI API (https://docs.opentyphoon.ai/en/)
TYPHOON_API_KEY=your-opentyphoon-api-key
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_TEXT_MODEL=typhoon-v2.5-30b-a3b-instruct
TYPHOON_OCR_MODEL=typhoon-ocr-v2

# Optional web search for Auto Scout listing discovery
# auto picks the first configured provider; or set tavily, exa, or firecrawl
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# Cron / Auto Tech Scout Protection (generate: openssl rand -hex 24)
CRON_SECRET=change-me-random-cron-secret

# Optional: Comma-separated primary admin emails protected from demotion/deletion
ADMIN_EMAILS=

# Optional: Discord Webhook for daily newly discovered tech competitions digest
DISCORD_WEBHOOK_URL=

# Optional: HMAC secret for signed admin webhook deliveries
WEBHOOK_SIGNING_SECRET=

# Optional: benchmark target when running scripts/bench-queries.mjs outside Docker
BENCH_DATABASE_URL=

# Optional SMTP delivery (password reset and reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server port (used by Docker Compose)
APP_PORT=3000

# Set to true only when served over HTTPS (false for HTTP Tailscale/LAN)
COOKIE_SECURE=false

# Set true only behind a trusted reverse proxy that overwrites forwarding headers
TRUST_PROXY_HEADERS=false
